      android:pathData="M62.48,83.62 L97.97,216.09 L125.74,112.45 L130.26,112.45 L158.03,216.09 L193.52,83.62 L166.48,76.38 L158.03,107.91 L151.74,84.45 L104.26,84.45 L97.97,107.91 L89.52,76.38 Z" />
