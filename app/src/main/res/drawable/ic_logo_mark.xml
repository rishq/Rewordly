<?xml version="1.0" encoding="utf-8"?>
<!--
  The in-app mark: brand-gradient flashcard with the white R, same geometry as
  the launcher foreground (ic_launcher_foreground.xml). Used on the splash
  screen; the surface behind it is the app background, so the card carries the
  brand colour itself. Hand-converted from rewordly-icon.svg.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="304"
    android:viewportHeight="304">

  <group android:translateX="-95" android:translateY="-108">
    <!-- flashcard, -8deg, filled with the R gradient -->
    <group android:rotation="-8" android:pivotX="247" android:pivotY="260">
      <path android:pathData="M178,122 H316 A38,38 0 0 1 354,160 V360 A38,38 0 0 1 316,398 H178 A38,38 0 0 1 140,360 V160 A38,38 0 0 1 178,122 Z">
        <aapt:attr name="android:fillColor">
          <gradient
            android:startColor="#6A3DF0"
            android:endColor="#2E8BFF"
            android:angle="45" />
        </aapt:attr>
      </path>
      <!-- the R -->
      <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="38"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M205,205 V325" />
      <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="38"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M205,205 H255 a46,46 0 0 1 0,92 H205" />
      <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="38"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M252,300 L298,340" />
    </group>
  </group>
</vector>
