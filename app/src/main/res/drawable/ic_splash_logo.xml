<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash icon for the SplashScreen API: brand flashcard fitted into the
  circular icon area that the system masks (108dp canvas, 72dp safe zone).
  Same symbol as drawable/ic_logo_mark.xml, scaled 0.18 so the tilted card's
  corners (half-diagonal ~32dp at this scale) stay inside the 36dp mask radius;
  the translate centres the card's art-space centre (247, 260) on the canvas.
  Hand-converted from rewordly-icon.svg.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <group android:scaleX="0.18" android:scaleY="0.18"
      android:translateX="9.54" android:translateY="7.2">
    <!-- flashcard, -8deg, filled with the R gradient -->
    <group android:rotation="-8" android:pivotX="247" android:pivotY="260">
      <path android:pathData="M178,122 H316 A38,38 0 0 1 354,160 V360 A38,38 0 0 1 316,398 H178 A38,38 0 0 1 140,360 V160 A38,38 0 0 1 178,122 Z">
        <aapt:attr name="android:fillColor">
          <gradient
            android:startColor="#6A3DF0"
            android:endColor="#2E8BFF"
            android:angle="45" />
        </aapt:attr>
      </path>
      <!-- the R -->
      <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="38"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M205,205 V325" />
      <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="38"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M205,205 H255 a46,46 0 0 1 0,92 H205" />
      <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="38"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M252,300 L298,340" />
    </group>
  </group>
</vector>
