<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome layer for themed icons (Android 13+). The system replaces every
  colour with a single tint, so a filled card would blob — this layer is the
  card OUTLINE plus the stroked R, same geometry as ic_launcher_foreground.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <group
    android:scaleX="0.12890625"
    android:scaleY="0.12890625"
    android:translateX="21"
    android:translateY="21">

    <group android:rotation="-8" android:pivotX="247" android:pivotY="260">
      <!-- 9-unit card outline: outer 214x276 (r=38) minus inner (r=29) -->
      <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M178,122 H316 A38,38 0 0 1 354,160 V360 A38,38 0 0 1 316,398 H178 A38,38 0 0 1 140,360 V160 A38,38 0 0 1 178,122 Z M178,131 H316 A29,29 0 0 1 345,160 V360 A29,29 0 0 1 316,389 H178 A29,29 0 0 1 149,360 V160 A29,29 0 0 1 178,131 Z" />
      <!-- the R -->
      <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="38"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M205,205 V325" />
      <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="38"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M205,205 H255 a46,46 0 0 1 0,92 H205" />
      <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="38"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M252,300 L298,340" />
    </group>
  </group>
</vector>
