<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
  <!-- Backup is opt-out: the on/off switch lives in Settings and is checked by RewordlyBackupAgent. -->
  <cloud-backup disableIfNoEncryptionCapabilities="true">
    <include domain="root" path="." />
  </cloud-backup>
  <device-transfer>
    <include domain="root" path="." />
  </device-transfer>
</data-extraction-rules>
